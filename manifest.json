{
  "manifest_version": 3,
  "name": "Twitch Chat on YouTube",
  "version": "1.0",
  "description": "Brings live Twitch chat overlays to YouTube stream pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
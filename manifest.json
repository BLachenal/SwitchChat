{
  "manifest_version": 3,
  "name": "SwitchChat",
  "version": "1.2",
  "description": "Brings live Twitch chat overlays to YouTube stream pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "switchchat-billylachenal@gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}
{
  "manifest_version": 3,
  "name": "SwitchChat",
  "version": "1.3",
  "description": "Brings live Twitch chat overlays to YouTube stream pages.",
  
  "permissions": [
    "activeTab",
    "storage"
  ],

  "optional_host_permissions": [
    "https://api.betterttv.net/*",
    "https://api.ivr.fi/*",
    "https://api.7tv.app/*"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.twitch.tv/embed/*/chat*"],
      "js": ["iframe-patch.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "switchchat-billylachenal@gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [ "none" ]
      }
    }
  }
}
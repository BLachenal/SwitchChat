{
  "manifest_version": 3,
  "name": "TwitchTubeChat",
  "version": "1.2",
  "description": "Brings live Twitch chat overlays to YouTube stream pages.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}